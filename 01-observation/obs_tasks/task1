<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Information Portal</title>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>ABC Engineering College</h1>
        <p>Welcome to the College Information Portal</p>
    </header>

    <hr>

    <!-- Navigation -->
    <nav>
        <a href="https://www.abccollege.edu">College Website</a> |
        <a href="https://www.google.com">Google</a>
    </nav>

    <hr>

    <!-- Section -->
    <section>

        <article>
            <h2>About Our College</h2>

            <p>
                ABC Engineering College is one of the leading institutions
                providing quality education in Engineering and Technology.
            </p>

            <h3>Text Formatting</h3>

            <p>
                <b>Bold Text</b><br>
                <i>Italic Text</i><br>
                <u>Underline Text</u><br>
                X<sup>2</sup><br>
                H<sub>2</sub>O
            </p>

        </article>

    </section>

    <hr>

    <!-- Lists -->

    <h2>Courses Offered (Ordered List)</h2>

    <ol>
        <li>CSE</li>
        <li>ECE</li>
        <li>EEE</li>
        <li>Mechanical</li>
    </ol>

    <h2>Facilities (Unordered List)</h2>

    <ul>
        <li>Library</li>
        <li>Computer Labs</li>
        <li>Sports</li>
        <li>Hostel</li>
    </ul>

    <hr>

    <!-- Table -->

    <h2>Student Details</h2>

    <table border="1" cellpadding="10">

        <tr>
            <th>Roll No</th>
            <th>Name</th>
            <th>Branch</th>
            <th>Email</th>
        </tr>

        <tr>
            <td>101</td>
            <td>Ravi</td>
            <td>CSE</td>
            <td>ravi@gmail.com</td>
        </tr>

        <tr>
            <td>102</td>
            <td>Priya</td>
            <td>ECE</td>
            <td>priya@gmail.com</td>
        </tr>

    </table>

    <hr>

    <!-- Images -->

    <h2>College Logo</h2>

    <img src="logo.png" alt="College Logo" width="200">

    <h2>Campus Image</h2>

    <img src="campus.jpg" alt="College Campus" width="400">

    <hr>

    <!-- Form -->

    <h2>Student Registration Form</h2>

    <form>

        Name:
        <input type="text">
        <br><br>

        Email:
        <input type="email">
        <br><br>

        Password:
        <input type="password">
        <br><br>

        Gender:
        <input type="radio" name="gender"> Male
        <input type="radio" name="gender"> Female
        <br><br>

        Hobbies:
        <input type="checkbox"> Reading
        <input type="checkbox"> Sports
        <input type="checkbox"> Music
        <br><br>

        Branch:
        <select>
            <option>CSE</option>
            <option>ECE</option>
            <option>EEE</option>
            <option>Mechanical</option>
        </select>

        <br><br>

        Comments:
        <textarea rows="4" cols="30"></textarea>

        <br><br>

        Date:
        <input type="date">

        <br><br>

        Number:
        <input type="number">

        <br><br>

        Favorite Color:
        <input type="color">

        <br><br>

        Satisfaction:
        <input type="range">

        <br><br>

        <input type="submit">
        <input type="reset">

    </form>

    <hr>

    <!-- Audio -->

    <h2>College Anthem</h2>

    <audio controls>
        <source src="song.mp3" type="audio/mpeg">
    </audio>

    <hr>

    <!-- Video -->

    <h2>College Tour</h2>

    <video width="500" controls>
        <source src="college.mp4" type="video/mp4">
    </video>

    <hr>

    <!-- Footer -->

    <footer>
        <p>&copy; 2026 ABC Engineering College</p>
    </footer>

</body>
</html>
